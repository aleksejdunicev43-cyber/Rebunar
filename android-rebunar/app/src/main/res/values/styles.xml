    <style name="RebunarTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/rebunar_icon_background</item>
        <item name="android:colorAccent">#FF4055</item>
        <item name="android:statusBarColor">#08090A</item>
        <item name="android:navigationBarColor">#08090A</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
